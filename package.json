{
  "name": "personal-assistant",
  "version": "0.1.0",
  "description": "插件化个人辅助软件 - 脚手架",
  "author": "hanjun",
  "main": "dist/main/index.js",
  "bin": {
    "uuutil": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently \"npm run dev:main\" \"npm run dev:renderer\"",
    "dev:main": "tsc -p tsconfig.main.json && NODE_ENV=development node ./node_modules/electron/cli.js dist/main/index.js",
    "dev:renderer": "vite",
    "build": "npm run build:main && npm run build:renderer",
    "build:main": "tsc -p tsconfig.main.json",
    "build:renderer": "vite build",
    "start": "electron dist/main/index.js",
    "pack": "electron-builder --dir",
    "cli:build": "tsc -p tsconfig.main.json"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.14.23",
    "@chakra-ui/react": "^2.10.10",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@tabler/icons-react": "^3.44.0",
    "@uiw/react-md-editor": "^4.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "framer-motion": "^11.18.2",
    "lucide-react": "^1.21.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^7.17.0",
    "sql.js": "^1.12.0",
    "uuid": "^9.0.0",
    "zod": "^4.4.3"
  },
  "build": {
    "appId": "com.personal-assistant.app",
    "productName": "个人辅助软件",
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": "dir"
    }
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "concurrently": "^9.1.0",
    "electron": "^42.4.0",
    "electron-builder": "^25.1.0",
    "rehype-highlight": "^7.0.2",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
